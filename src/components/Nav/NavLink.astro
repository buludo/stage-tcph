---
import { type navLinkItem } from "@config/navData.json";
import { normalizePath, withBase } from "@js/pathUtils";

interface Props {
	navItem: navLinkItem;
	class?: string;
}

const { navItem, class: className } = Astro.props as Props;
const { text, link, newTab = false } = navItem;
const href = withBase(link);
const isActive = normalizePath(Astro.url.pathname) === normalizePath(href);

// if the current page is the same as the link, we change the styling
---

<li>
	<a
		class:list={[
			`primary-focus hover:text-primary-700 relative block w-full px-4 py-2 font-medium transition ${className}`,
			{
				// styling for current active page link
				"text-base-600": isActive,
			},
		]}
		href={href}
		target={newTab ? "_blank" : ""}
		rel={newTab ? "noopener noreferrer" : ""}
	>
		{text}
	</a>
</li>
