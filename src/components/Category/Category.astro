---
import { withBase } from "@js/pathUtils";
import { categorify, slugify } from "@js/textUtils";

interface Props {
	category: string;
	class?: string;
}

const { category, class: className } = Astro.props as Props;
---

<a href={withBase(`/categories/${slugify(category)}/`)} class={`main-text-gradient font-medium ${className}`}>
	{categorify(category)}
</a>
