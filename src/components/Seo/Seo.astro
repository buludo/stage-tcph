---
import siteData from "@config/siteData.json";
import { getImage } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import { SEO } from "astro-seo";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
}

interface GenProps extends BaseProps {
	type: "general";
	image?: any;
}

interface BlogProps extends BaseProps {
	type: "blog";
	image: CollectionEntry<"blog">["data"]["heroImage"];
	authors: CollectionEntry<"authors">[];
	postFrontmatter: CollectionEntry<"blog">["data"];
}

const { type, title, description, image, noindex = false } = Astro.props as GenProps | BlogProps;

let optimizedImage;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// if this is a blog page we do things differently
if (type === "blog") {
	optimizedImage = await getImage({
		src: image,
		format: "webp",
		quality: "high",
		width: 1200,
	});
}

function trimEndSlash(str: string) {
	if (str[str.length - 1] === "/") {
		return str.slice(0, -1);
	} else {
		return str;
	}
}

// put together the image URL
const imageUrl =
	trimEndSlash(Astro.site?.toString() || "") + (optimizedImage?.src || siteData.defaultImage.src);

// Only blog posts go through getImage, which always emits webp. Everything else
// falls back to the file in /public, so describe that file rather than assuming.
const mimeTypes: Record<string, string> = {
	png: "image/png",
	jpg: "image/jpeg",
	jpeg: "image/jpeg",
	webp: "image/webp",
	gif: "image/gif",
};
const defaultImageExt = siteData.defaultImage.src.split(".").pop()?.toLowerCase() ?? "";
const imageType = optimizedImage ? "image/webp" : (mimeTypes[defaultImageExt] ?? "image/png");
const imageWidth = optimizedImage?.attributes.width || siteData.defaultImage.width;
const imageHeight = optimizedImage?.attributes.height || siteData.defaultImage.height;
---

<SEO
	title={title}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: title,
			type: "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.title,
		},
		image: {
			type: imageType,
			width: imageWidth,
			height: imageHeight,
			alt: title,
		},
	}}
	twitter={{
		site: "@" + siteData.author.twitter,
		creator: "@" + siteData.author.twitter,
		card: "summary_large_image",
		title: title,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>
